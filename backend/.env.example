# CityWatch Backend — Environment Variables
# ──────────────────────────────────────────────────────────────
# Copy this file to backend/.env and fill in your real values.
# NEVER commit backend/.env to Git.
# ──────────────────────────────────────────────────────────────

# JWT Secret — generate a random 64+ character string
CW_JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_STRING

# ── Supabase PostgreSQL (Recommended) ─────────────────────────
DB_URL=jdbc:postgresql://aws-1-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require
DB_USERNAME=postgres.YOUR_SUPABASE_PROJECT_REF
DB_PASSWORD=YOUR_SUPABASE_DB_PASSWORD

# ── Local PostgreSQL (Alternative for local dev) ──────────────
# DB_URL=jdbc:postgresql://localhost:5432/citywatch
# DB_USERNAME=postgres
# DB_PASSWORD=your_local_postgres_password
