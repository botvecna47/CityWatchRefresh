# CityWatch Frontend — Environment Variables
# ──────────────────────────────────────────────────────────────
# Copy this file to frontend/.env and fill in your real values.
# NEVER commit frontend/.env to Git.
# ──────────────────────────────────────────────────────────────

# Supabase Project URL — found in Supabase Dashboard > Settings > API
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Supabase Anon (Public) Key — found in Supabase Dashboard > Settings > API
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Optional: Override the backend API URL (leave blank for local development)
# VITE_API_URL=https://your-deployed-backend.render.com
